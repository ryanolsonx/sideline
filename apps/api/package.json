{
  "name": "@sideline/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "schema:generate": "nest build && node dist/schema.js",
