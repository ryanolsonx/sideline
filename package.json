{
  "name": "sideline",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sideline/api --filter @sideline/web dev",
    "setup": "pnpm install && pnpm db:up && pnpm db:migrate && pnpm schema:generate && pnpm codegen",
    "serve": "pnpm dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @sideline/api dev",
    "dev:web": "pnpm --filter @sideline/web dev",
    "db:migrate": "pnpm --filter @sideline/api db:migrate",
    "schema:generate": "pnpm --filter @sideline/api schema:generate",
    "codegen": "pnpm --filter @sideline/web codegen",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:bdd": "cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.13"
  }
}
