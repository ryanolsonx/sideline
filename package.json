{
  "name": "sideline",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:api": "pnpm --filter @sideline/api dev",
    "db:migrate": "pnpm --filter @sideline/api db:migrate"
  }
}
